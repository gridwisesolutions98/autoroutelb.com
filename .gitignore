# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

backups/

/app/generated/prisma

# local database (contains real runtime data, including plaintext credentials)
*.db
*.db-journal
*.db-wal
*.db-shm

# user-uploaded content (runtime data, not source — lives on the persistent volume in production)
/public/uploads/*
!/public/uploads/.gitkeep

# local tool/session state, not project config
.claude/settings.local.json
.claude/scheduled_tasks.lock
.windsurf/
